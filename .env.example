# Required Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric Telegram user ID of the sole owner
OWNER_ID=

# Optional HTTPS links used by the /start menu
MAIN_GROUP_URL=
OWNER_CONTACT_URL=

# Optional NVIDIA NIM AI content safety (disabled by default)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
AI_GUARD_ENABLED=false
